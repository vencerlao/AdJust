{
  "buildCommand": "flutter build web --build-number=$BUILD_ID --dart-define=API_URL=$API_URL",
  "outputDirectory": "build/web",
  "framework": "flutter",
  "env": {
    "API_URL": {
      "description": "Backend API URL (Hugging Face Space URL)",
      "type": "string",
      "required": false,
      "default": "https://your-hf-space-url"
    }
  },
  "functions": {
    "api/**": {
      "runtime": "python@3.12"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
